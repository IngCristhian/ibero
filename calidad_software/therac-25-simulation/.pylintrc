[MASTER]
# Pylint configuration for Therac-25 simulation
# Focused on catching the types of bugs that caused patient deaths

# Use multiple processes for faster analysis
jobs=0

# Add paths to sys.path
init-hook='import sys; sys.path.append("src")'

[MESSAGES CONTROL]
# Enable all warnings that would catch Therac-25 bugs
enable=all

# Disable only cosmetic issues, keep all safety-critical checks
disable=
    missing-docstring,
    line-too-long,
    invalid-name,
    too-few-public-methods

# Focus on these critical categories:
# - concurrency issues
# - error handling
# - type safety
# - logic errors
# - resource management

[REPORTS]
# Output format
output-format=parseable

# Include these reports
reports=yes

[REFACTORING]
# Maximum number of nested blocks (Therac-25 had complex nested logic)
max-nested-blocks=6

# Maximum number of arguments for function (safety-critical code should be simple)
max-args=7

# Maximum number of local variables
max-locals=20

# Maximum number of return statements
max-returns=6

# Maximum number of branches
max-branches=12

# Maximum number of statements
max-statements=50

[BASIC]
# Good variable names for safety-critical code
good-names=i,j,k,ex,Run,_,x,y,id

# Bad variable names that could cause confusion
bad-names=foo,bar,baz,toto,tutu,tata

[FORMAT]
# Maximum line length
max-line-length=100

# String used as indentation unit
indent-string='    '

[LOGGING]
# Logging modules to check
logging-modules=logging

[MISCELLANEOUS]
# List of note tags to take into consideration
notes=FIXME,XXX,TODO,BUG,HACK,CRITICAL,SAFETY